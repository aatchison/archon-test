{
  "name": "Archon Dev",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  // Use features instead of Dockerfile or postCreateCommand where possible
  "features": {
    "ghcr.io/shyim/devcontainers-features/bun:latest": {},
    "ghcr.io/devcontainers/features/git:latest": {},
    "ghcr.io/devcontainers/features/docker-in-docker:latest": {
      "moby": false,
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/aws-cli:latest": {},
    "ghcr.io/devcontainers/features/common-utils:latest": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true
    }
  },

  // Mount SSH agent, git config, and AWS credentials from host at build time
  "mounts": [
    // Git identity
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,readonly",
    // opencode config (local models, API keys) — needed for Gemma inside devcontainer
    "source=${localEnv:HOME}/.config/opencode,target=/root/.config/opencode,type=bind,readonly"
  ],

  // SSH agent — mount conditionally via initializeCommand if SSH_AUTH_SOCK is set
  "remoteEnv": {
    "SSH_AUTH_SOCK": "${localEnv:SSH_AUTH_SOCK}"
  },

  // Forward SSH agent socket if available
  "initializeCommand": "echo 'SSH_AUTH_SOCK=${SSH_AUTH_SOCK:-not set}'",

  // Install dependencies once on container create (not a post-run step or Dockerfile layer)
  "onCreateCommand": "bun install && (curl -fsSL https://opencode.ai/install | bash || true)",

  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        "github.vscode-pull-request-github"
      ],
      "settings": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true,
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
