  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test lib/password.test.ts actions/lists.test.ts actions/tasks.test.ts components/list-card.test.tsx components/task-item.test.tsx",
